    <!-- Onboarding -->
    <string name="onboarding_page1_title">LA MARCHE DES ÂMES</string>
    <string name="onboarding_page1_text">Your steps become the distance travelled in an endless dungeon, whether they come from Garmin or Health Connect. 10 steps = 1 metre. Fights, guardians and chests progress without you having to play continuously.</string>
    <string name="onboarding_page1_note">The game is played by walking, not by staying on the screen.</string>
    <string name="onboarding_page2_title">STEP SOURCE</string>
    <string name="onboarding_page2_text">Garmin uses a personal key and a 24-hour token. Health Connect reads steps recorded by Google Fit, Samsung Health or a watch. You can change source at any time in Settings.</string>
    <string name="onboarding_page2_note">Only one source is active at a time: no double counting.</string>
    <string name="onboarding_page3_title">SETTINGS AND ALERTS</string>
    <string name="onboarding_page3_text">You can adjust the text size, turn off notifications, reduce animations and export your save from the Settings screen.</string>
    <string name="onboarding_page3_note">Notifications can be disabled at any time.</string>
    <string name="onboarding_page4_title">THE CAMPFIRE</string>
    <string name="onboarding_page4_text">The camp pauses the walk, heals the hero and lets you manage equipment. Steps continue to be banked during the pause.</string>
    <string name="onboarding_page4_note">Resume the expedition when you are ready.</string>
